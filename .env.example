# KarmYog Vatika — environment template
# Copy to .env.local for development. Never commit real secrets.

# Site
NEXT_PUBLIC_SITE_URL=https://karmyog-vatika-seven.vercel.app

# Supabase (optional until provisioned — APIs fall back to pledge/memory mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (optional until KYC — donation form uses pledge mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Receipts / email (optional)
# RESEND_API_KEY=
# RECEIPT_FROM_EMAIL=receipts@example.org

# Legal payee copy (shown on donate pages when set)
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# NEXT_PUBLIC_EIGHTY_G_TEXT=
