# KarmYog Vatika / BKS KY21C Plantation Drive — environment template
# Copy to .env.local for development. Never commit real secrets.

# Site
NEXT_PUBLIC_SITE_URL=https://bks-ky21c-plantation-drive.vercel.app

# Supabase (optional until provisioned — APIs fall back to JSON memory mode)
# Apply migrations: supabase/migrations/001_init.sql then 002_space_applications.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (optional until KYC — donation form uses pledge mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Receipts / space-application Word email (optional — Resend)
# When set, online Apply emails the .docx to the Plants Donation desk (+ CC applicant).
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=

# Legal payee copy (shown on donate pages when set)
# NEXT_PUBLIC_LEGAL_ENTITY_NAME=
# NEXT_PUBLIC_EIGHTY_G_TEXT=
